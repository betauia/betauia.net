{
  "name": "web",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.9.0",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && svelte-check && prettier --check \"src/**/*.{astro,svelte,ts,js,mjs,css}\"",
    "format": "prettier --write \"src/**/*.{astro,svelte,ts,js,mjs,css}\""
  },
  "dependencies": {
    "@astrojs/check": "0.9.11",
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/mdx": "8.1.0",
    "@astrojs/node": "11.1.9",
    "@astrojs/svelte": "9.1.0",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource/medievalsharp": "^5.2.8",
    "@fontsource/poppins": "^5.2.7",
    "@iconify-json/fa": "^1.2.2",
    "@iconify-json/fa-brands": "^1.2.2",
    "@iconify-json/fa-solid": "^1.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "7.4.1",
    "astro-icon": "^1.1.5",
    "katex": "^0.19.0",
    "marked": "^17.0.5",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",

    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.2",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte-check": "^4.7.7"
  }

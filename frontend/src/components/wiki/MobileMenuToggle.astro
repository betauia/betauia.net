<style is:global>
  .wiki-menu-button:has(~ :popover-open) .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .wiki-menu-button:has(~ :popover-open) .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .wiki-menu-button:has(~ :popover-open) .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  @media (max-width: 799px) {
    body:has(#starlight__sidebar:popover-open) {
      overflow: hidden;
    }
  }

<button
  popovertarget="starlight__sidebar"
  class="wiki-menu-button group fixed right-[var(--sl-nav-pad-x)] top-0 z-10 flex h-16 items-center justify-center px-2 min-[800px]:hidden print:hidden"
  type="button"
>
  <div class="relative h-5 w-6">
    <span class="hamburger-line absolute left-0 top-0 block h-[3px] w-full rounded-full bg-fg-muted transition-all duration-200 ease-out group-hover:bg-fg-base dark:bg-dark-fg-muted dark:group-hover:bg-dark-fg-base"></span>

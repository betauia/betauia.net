---
import BaseLayout from "@layouts/BaseLayout.astro";
import BetaLANLayout from "@layouts/BetaLANLayout.astro";
import { Icon } from "astro-icon/components";

const oceanBg =
  "background: linear-gradient(180deg, #a6e6ff 0%, #5fc4e8 24%, #2e9ed1 48%, #1a6aa8 72%, #0a3f72 88%, #042a52 100%); background-attachment: fixed;";

const program = [
  {
    day: "Friday",
    items: [
      { title: "Opening for CTF", time: "16:45" },
      { title: "IntroCTF with UiACTF & BetaSEC (Free entry!)", time: "17:00 - 20:00" },
      { title: "Closing Main Hall for reorganization", time: "20:00" },
      { title: "Opening for LAN event", time: "21:00" },
      { title: "Auby Games Opens (Annoucement)", time: "21:15" },
      { title: "Skylanders", time: "21:30 - 23:00" },
      { title: "BetaShow", time: "23:00 - 00:00" },
    ],
  },
  {
    day: "Saturday",
    items: [
      { title: "The Finals", time: "13:00 - 15:00" },
      { title: "Game Jam", time: "16:00 - 17:00" },
      { title: "Food", time: "17:00 - 19:00" },
      { title: "Minecraft: Skywars", time: "19:00 - 21:00" },
      { title: "BetaShow", time: "23:00 - 00:00" },
    ],
  },
  {
    day: "Sunday",
    items: [
      { title: "Final Duel — Auby Games", time: "12:00 - 13:00" },
      { title: "Fortnite", time: "14:00 - 16:00" },
      { title: "Omega Strikers", time: "16:00 - 18:00" },
      { title: "Closing Hour", time: "18:15" },
    ],
  },
];
---

<BaseLayout title="BetaLAN Program H26">
  <BetaLANLayout backgroundCss={oceanBg} UseGamerFont={false}>
    <section
      class="mx-3 mb-4 max-w-4xl rounded-lg bg-sky-950/85 p-4 text-lg text-cyan-50 sm:m-6 sm:p-6 lg:mx-auto"
    >
      <div>
        <h1 class="mb-6 text-center text-4xl font-bold text-orange-400 md:text-7xl">
          BetaLAN Program
        </h1>

        {
          program.map(day => (
            <div class="mb-8 sm:mb-10">
              <h2 class="mb-3 border-b border-cyan-400 pb-1 text-2xl font-bold text-cyan-300 md:text-3xl">
                {day.day}
              </h2>
              <ul class="space-y-0">
                {day.items.map(item => (
                  <li class="flex flex-col justify-between border-b border-cyan-900/40 py-3 text-lg sm:flex-row sm:border-none sm:py-2 md:text-xl">
                    <span class="font-medium">{item.title}</span>
                    {item.time ? <span>{item.time}</span> : <span>&nbsp;</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        <div class="mb-2 mt-6 border-t border-cyan-800 pt-4 text-center sm:mt-8">
          <div class="mt-2 sm:mt-4">
            <h3 class="mb-2 text-lg font-medium md:text-xl">Join BetaLAN Discord</h3>
            <p class="mb-3">
              Connect with other participants and get real-time updates during the event
            </p>
            <a
              href="https://discord.gg/ggUtjr8TSQ"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-md bg-indigo-700 px-3 py-1.5 text-white transition-colors hover:bg-indigo-600 sm:px-4 sm:py-2"
            >
              <Icon name="fa-brands:discord" class="mb-2 h-12 w-12" />
              <span>BetaLAN Discord</span>
            </a>
          </div>
        </div>
      </div>
    </section>
    <br />
  </BetaLANLayout>
</BaseLayout>

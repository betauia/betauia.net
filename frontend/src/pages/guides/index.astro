---
import { Icon } from "astro-icon/components";
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/layout/Container.astro";
import Prose from "@components/semantics/Prose.astro";

const pages = [
  {
    category: "Programmering",
    path: "prog",
    description: "Guider for programmering, utviklingsverktøy og arbeidsflyt.",
    guides: [
      {
        name: "Git",
        path: "git",
        icon: "fa-brands:git-alt",
        description: "Lær grunnleggende Git og versjonskontroll.",
      },
    ],
  },
  {
    category: "Matte 1",
    path: "ma-178",
    description: "Guider og ressurser for Matte 1.",
    guides: [
      {
        name: "Komplekse tall",
        path: "kompleks",
        icon: "fa-solid:magic",
        description: "Lær om komplekse tall og hvordan de brukes.",
      },
    ],
  },
];
---

<BaseLayout title="Guider">
  <Container>
    <Prose>
      <h1>Guider</h1>
      <p>En samling guider og ressurser for fag, programmering og verktøy.</p>
    </Prose>

    <div class="mt-10">
      {
        pages.map(page => (
          <>
            <div class="">
              <h2 class="text-2xl font-bold text-fg-base transition-colors dark:text-dark-fg-base">
                {page.category}
              </h2>

              <p class="mb-6 mt-4 max-w-2xl text-base text-fg-muted dark:text-dark-fg-muted">
                {page.description}
              </p>
            </div>

            <div class="mb-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {page.guides.map(guide => (
                <a
                  href={`/guides/${page.path}/${guide.path}`}
                  class="group rounded-2xl border border-dark-fg-muted bg-bg-raised p-5 transition-colors hover:bg-bg-raised/25 dark:border-fg-muted dark:bg-dark-bg-raised hover:dark:bg-dark-bg-raised/50"
                >
                  <div class="flex items-start gap-4">
                    <div class="mt-0.5 shrink-0">
                      <Icon
                        name={guide.icon}
                        class="h-6 w-6 text-accent transition-transform duration-200"
                      />
                    </div>

                    <div>
                      <h3 class="text-lg font-bold text-fg-base transition-colors dark:text-dark-fg-base">
                        {guide.name}
                      </h3>

                      <p class="mt-1.5 text-base leading-6 text-fg-muted dark:text-dark-fg-muted">
                        {guide.description}
                      </p>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </>
        ))
      }
    </div>
  </Container>
</BaseLayout>

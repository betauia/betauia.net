---
import Container from "@components/layout/Container.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/ui/Button.astro";
import { useTranslations } from "@i18n/utils.ts";
import Translate from "@components/ui/Translate.astro";

const t = useTranslations(Astro.currentLocale);
---

<BaseLayout title="404">
  <Container class="flex min-h-svh flex-col items-center justify-center text-center">
    <h1 class="text-4xl font-semibold"><Translate key="page.404.title" /></h1>
    <p class="mt-4 text-xl text-fg-muted dark:text-dark-fg-muted" id="random-error-message">
      <Translate key="page.404.message" />
    </p>
    <div class="mt-6 flex gap-4">
      <Button href="/" type="primary"><Translate key="page.404.back" /></Button>
      <Button href="mailto:post@betauia.net" type="secondary">
        <Translate key="page.404.contact" />
      </Button>
    </div>
  </Container>
</BaseLayout>

<!-- Random error message -->
<script>
  import { extractCurrentLanguage, useTranslations } from "@i18n/utils.ts";

  const t = useTranslations(extractCurrentLanguage());
  const messages = [
    t("page.404.messages.1"),
    t("page.404.messages.2"),
    t("page.404.messages.3"),
    t("page.404.messages.4"),
    t("page.404.messages.5"),
    t("page.404.messages.6"),
    t("page.404.messages.7"),
    t("page.404.messages.8"),
    t("page.404.messages.9"),
    t("page.404.messages.10"),
    t("page.404.messages.11"),
    t("page.404.messages.12"),
  ];

  const errorElement = document.getElementById("random-error-message");
  if (errorElement) {
    errorElement.innerText = messages[Math.floor(Math.random() * messages.length)];
  }
</script>

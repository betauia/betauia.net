---
import Container from "@components/layout/Container.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/ui/Button.astro";
import { useTranslations } from "@i18n/utils.ts";
import Translate from "@components/ui/Translate.astro";

const t = useTranslations("404", Astro.currentLocale);
---

<BaseLayout title="404">
  <Container class="flex min-h-svh flex-col items-center justify-center text-center">
    <h1 class="text-4xl font-semibold"><Translate page="404" key="title" /></h1>
    <p class="mt-4 text-xl text-fg-muted dark:text-dark-fg-muted" id="random-error-message">
      <Translate page="404" key="message" />
    </p>
    <div class="mt-6 flex gap-4">
      <Button href="/" type="primary"><Translate page="404" key="back" /></Button>
      <Button href="mailto:post@betauia.net" type="secondary">
        <Translate page="404" key="contact" />
      </Button>
    </div>
  </Container>
</BaseLayout>

<!-- Random error message -->
<script>
  import { extractCurrentLanguage, useTranslations } from "@i18n/utils.ts";

  const t = useTranslations("404", extractCurrentLanguage());
  const messages = [
    t("messages.1"),
    t("messages.2"),
    t("messages.3"),
    t("messages.4"),
    t("messages.5"),
    t("messages.6"),
    t("messages.7"),
    t("messages.8"),
    t("messages.9"),
    t("messages.10"),
    t("messages.11"),
    t("messages.12"),
  ];

  const errorElement = document.getElementById("random-error-message");
  if (errorElement) {
    errorElement.innerText = messages[Math.floor(Math.random() * messages.length)];
  }
</script>

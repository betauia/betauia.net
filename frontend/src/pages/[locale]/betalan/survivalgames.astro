---
import Tournament from "@layouts/tournament.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import minecraftSurvivalGames from "@assets/betalan/tournaments/minecraft-survival-games.png";
import minecraftPotionBottle from "@assets/betalan/tournaments/minecraft-potion-bottle.png";
import { Icon } from "astro-icon/components";
import { getStaticLanguagePaths, useTranslations } from "@i18n/utils.ts";
import Translate from "@components/ui/Translate.astro";
import A from "@components/ui/A.astro";

export const getStaticPaths = getStaticLanguagePaths();
const t = useTranslations(Astro.currentLocale);
---

<BaseLayout
  title={t("page.betalan.survivalgames.title")}
  description={t("page.betalan.survivalgames.description")}
>
  <Tournament UseGamerFont={true}>
    <h1 class="title"><Translate key="page.betalan.survivalgames.heading" /></h1>
    <img src={minecraftSurvivalGames.src} alt={t("page.betalan.survivalgames.imageAlt")} class="responsive-img" />
    <h2 class="section-title"><Translate key="page.betalan.survivalgames.whatIs.title" /></h2>

    <p class="paragraph">
      <Translate key="page.betalan.survivalgames.whatIs.intro">
        <span slot="hungerGames" class="font-semibold text-red-600 drop-shadow-lg"
          ><Translate key="page.betalan.survivalgames.whatIs.hungerGames" /></span
        >
      </Translate>
    </p>
    <Translate key="page.betalan.survivalgames.whatIs.outro" />
  </Tournament>

  <h2 class="section-title"><Translate key="page.betalan.survivalgames.participate.title" /></h2>
  <p class="paragraph">
    <Translate key="page.betalan.survivalgames.participate.text">
      <A
        slot="form"
        href="https://forms.gle/HCHSQVFEUZDAop7Y9"
        class="text-blue-400 hover:underline"
        target="_blank"
        aria-label={t("page.betalan.survivalgames.participate.formAriaLabel")}
      ><Translate key="page.betalan.survivalgames.participate.formLink" /></A
      >
    </Translate>
  </p>

  <h2 class="section-title"><Translate key="page.betalan.survivalgames.server.title" /></h2>

  <div class="mb-4 text-center">
    <code
      class="inline-flex cursor-pointer select-all items-center justify-center rounded bg-gray-900 px-4 py-2 font-mono text-2xl text-green-400 transition-colors hover:bg-gray-700"
      onclick="navigator.clipboard.writeText('mc.betauia.net'); this.querySelector('.copy-icon').classList.add('animate-ping'); setTimeout(() => this.querySelector('.copy-icon').classList.remove('animate-ping'), 700)"
    >
      mc.betauia.net <Icon
        name="fa-solid:copy"
        class="copy-icon ml-2 inline h-6 w-6 align-middle transition-transform hover:scale-110"
      />
    </code>
  </div>

  <h2 class="section-title"><Translate key="page.betalan.survivalgames.prize.title" /></h2>

  <img
    src={minecraftPotionBottle.src}
    alt={t("page.betalan.survivalgames.prize.imageAlt")}
    class="responsive-img"
    style="max-width: 250px;"
  />

  <ul class="link-center">
    <li class="list-item">
      <Translate key="page.betalan.survivalgames.prize.first" />
    </li>
  </ul>

  <h2 class="section-title"><Translate key="page.betalan.survivalgames.rules.title" /></h2>

  <p class="paragraph"><Translate key="page.betalan.survivalgames.rules.intro" /></p>

  <ul class="list">
    <li class="list-item">
      <Translate key="page.betalan.survivalgames.rules.who" />
    </li>
    <li class="list-item">
      <Translate key="page.betalan.survivalgames.rules.wins" />
    </li>
    <li class="list-item">
      <Translate key="page.betalan.survivalgames.rules.remember" />
    </li>
  </ul>

  <p class="text-2xl italic text-red-600">
    <Translate key="page.betalan.survivalgames.rules.warning" />
  </p>

  <h2 class="section-title"><Translate key="page.betalan.survivalgames.how.title" /></h2>

  <p class="paragraph">
    <Translate key="page.betalan.survivalgames.how.text" />
  </p>

  <h2 class="section-title"><Translate key="page.betalan.survivalgames.when.title" /></h2>

  <p class="paragraph"><Translate key="page.betalan.survivalgames.when.text" /></p>
</BaseLayout>

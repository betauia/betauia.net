---
import BaseLayout from "@layouts/BaseLayout.astro";
import BetaLANLayout from "@layouts/BetaLANLayout.astro";
import jungleBackground from "@assets/betalan/jungle-background.jpg";
import { getStaticLanguagePaths, useTranslations } from "@i18n/utils.ts";

export const getStaticPaths = getStaticLanguagePaths();
const t = useTranslations(Astro.currentLocale);
---

<BaseLayout title={t("page.betalan.about.title")}>
  <BetaLANLayout backgroundImage={jungleBackground.src} />
</BaseLayout>

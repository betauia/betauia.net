---
import BaseLayout from "@layouts/BaseLayout.astro";
import BetaLANLayout from "@layouts/BetaLANLayout.astro";
import { getStaticLanguagePaths, useTranslations } from "@i18n/utils.ts";

export const getStaticPaths = getStaticLanguagePaths();
const t = useTranslations("betalan/about", Astro.currentLocale);

const oceanBg =
  "background: linear-gradient(180deg, #a6e6ff 0%, #5fc4e8 24%, #2e9ed1 48%, #1a6aa8 72%, #0a3f72 88%, #042a52 100%); background-attachment: fixed;";
---

<BaseLayout title={t("title")}>
  <BetaLANLayout backgroundCss={oceanBg} />
</BaseLayout>

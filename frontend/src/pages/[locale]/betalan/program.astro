---
import BaseLayout from "@layouts/BaseLayout.astro";
import BetaLANLayout from "@layouts/BetaLANLayout.astro";
import { Icon } from "astro-icon/components";

import CastleWallImg from "@assets/betalan/castle-wall-betalan.jpg";
import { getStaticLanguagePaths, useTranslations } from "@i18n/utils.ts";
import Translate from "@components/ui/Translate.astro";
import A from "@components/ui/A.astro";

export const getStaticPaths = getStaticLanguagePaths();

const t = useTranslations(Astro.currentLocale);

const program = [
  {
    day: t("page.betalan.program.days.friday.name"),
    items: [
      { title: t("page.betalan.program.days.friday.items.opening"), time: "17:00 - 18:00" },
      { title: t("page.betalan.program.days.friday.items.tbdActivity"), time: "18:00 - 19:00" },
      { title: t("page.betalan.program.days.friday.items.aubyOpens"), time: "19:00" },
      { title: t("page.betalan.program.days.friday.items.smash"), time: "19:15 - 23:00" },
      { title: t("page.betalan.program.days.friday.items.betaShow"), time: "23:00 - 00:00" },
    ],
  },
  {
    day: t("page.betalan.program.days.saturday.name"),
    items: [
      { title: t("page.betalan.program.days.saturday.items.minecraft"), time: "15:00 - 17:00" },
      { title: t("page.betalan.program.days.saturday.items.food"), time: "17:00 - 19:00" },
      { title: t("page.betalan.program.days.saturday.items.bestGamer"), time: "19:00 - 23:00" },
      { title: t("page.betalan.program.days.saturday.items.betaShow"), time: "23:00 - 00:00" },
    ],
  },
  {
    day: t("page.betalan.program.days.sunday.name"),
    items: [
      { title: t("page.betalan.program.days.sunday.items.justDance"), time: "14:00 - 16:00" },
      { title: t("page.betalan.program.days.sunday.items.aubyFinal"), time: "16:15 - 17:00" },
      { title: t("page.betalan.program.days.sunday.items.aubyWinner"), time: "17:00" },
      { title: t("page.betalan.program.days.sunday.items.closingAnnouncement"), time: "17:15 - 18:00" },
      { title: t("page.betalan.program.days.sunday.items.closingTime"), time: "18:15" },
    ],
  },
];
---

<BaseLayout title={t("page.betalan.program.title")}>
  <BetaLANLayout backgroundImage={CastleWallImg.src} UseGamerFont={false}>
    <section
      class="font-medieval mx-3 mb-4 max-w-4xl rounded-lg bg-slate-800 bg-opacity-90 p-4 text-lg text-yellow-100 sm:m-6 sm:p-6 lg:mx-auto"
    >
      <div>
        <h1 class="mb-6 text-center text-4xl font-bold md:text-7xl"><Translate key="page.betalan.program.heading" /></h1>

        {
          program.map(day => (
            <div class="mb-8 sm:mb-10">
              <h2 class="mb-3 border-b border-yellow-300 pb-1 text-2xl font-bold text-yellow-300 md:text-3xl">
                {day.day}
              </h2>
              <ul class="space-y-0">
                {day.items.map(item => (
                  <li class="flex flex-col justify-between border-b border-yellow-900/30 py-3 text-lg sm:flex-row sm:border-none sm:py-2 md:text-xl">
                    <span class="font-medium">{item.title}</span>
                    {item.time ? <span>{item.time}</span> : <span>&nbsp;</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        <div class="mb-2 mt-6 border-t border-yellow-800 pt-4 text-center sm:mt-8">
          <div class="mt-2 sm:mt-4">
            <h3 class="mb-2 text-lg font-medium md:text-xl"><Translate key="page.betalan.program.discord.title" /></h3>
            <p class="mb-3"><Translate key="page.betalan.program.discord.text" /></p>
            <A
              href="https://discord.gg/ggUtjr8TSQ"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-md bg-indigo-700 px-3 py-1.5 text-white transition-colors hover:bg-indigo-600 sm:px-4 sm:py-2"
            >
              <Icon name="fa-brands:discord" class="mb-2 h-12 w-12" />
              <span><Translate key="page.betalan.program.discord.button" /></span>
            </A>
          </div>
        </div>
      </div>
    </section>
    <br />
  </BetaLANLayout>
</BaseLayout>

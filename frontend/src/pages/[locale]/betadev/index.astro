---
import Container from "@components/layout/Container.astro";
import Card from "@components/ui/Card.astro";
import Prose from "@components/semantics/Prose.astro";
import Button from "@components/ui/Button.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getStaticLanguagePaths, useTranslations } from "@i18n/utils.ts";
import Translate from "@components/ui/Translate.astro";

import Game1 from "@assets/betadev/game-1.jpg";
import Game3 from "@assets/betadev/game-3.jpg";
import GamejamPrize from "@assets/betadev/gamejam-trofe.jpg";
import { Image } from "astro:assets";

import logoBlack from "../../../assets/logos/betadev/black.png";
import logoWhite from "../../../assets/logos/betadev/white.png";
import logoBlue from "../../../assets/logos/betadev/blue.png";

export const getStaticPaths = getStaticLanguagePaths();
const t = useTranslations(Astro.currentLocale);

---

<BaseLayout
  title="Betadev"
  description={t("page.betadev.index.description")}
>
  <Container>
    <Prose>
      <center>
        <Image src src={logoBlue} alt={t("page.betadev.index.logoAlt")} inferSize class="h-auto w-[60%] pb-4" />
      </center>

      <p><Translate key="page.betadev.index.intro" /></p>

      <h2 class="mt-8 text-xl font-bold"><Translate key="page.betadev.index.events.title" /></h2>
    </Prose>

    <div class="mb-4 mt-2 grid gap-4 md:grid-cols-3">
      <Card
        title={t("page.betadev.index.events.gamejam.title")}
        href="/betadev/gamejam"
        image={Game3}
        text={t("page.betadev.index.events.gamejam.text")}
      />
      <Card
        title={t("page.betadev.index.events.codeCompetition.title")}
        image={GamejamPrize}
        text={t("page.betadev.index.events.codeCompetition.text")}
      />
      <Card
        title={t("page.betadev.index.events.codeNights.title")}
        image={Game1}
        text={t("page.betadev.index.events.codeNights.text")}
      />
    </div>
    <Prose>
      <p><Translate key="page.betadev.index.events.footnote" /></p>

      <h2><Translate key="page.betadev.index.communication.title" /></h2>
    </Prose>
    <Button href=""><Translate key="page.betadev.index.communication.discordButton" /></Button>
  </Container>
</BaseLayout>

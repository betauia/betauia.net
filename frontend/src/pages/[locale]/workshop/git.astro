---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/layout/Container.astro";
import GitGudImage from "@assets/gitgud.png";

import { Image } from "astro:assets";

import { Icon } from "astro-icon/components";
import { getStaticLanguagePaths } from "@i18n/utils.ts";
import { useTranslations } from "@i18n/utils.ts";
import A from "@components/ui/A.astro";
import Translate from "@components/ui/Translate.astro";

export const getStaticPaths = getStaticLanguagePaths();
const t = useTranslations("workshop/git", Astro.currentLocale);
---

<BaseLayout title={t("title")}>
  <Container>
    <h1
      class="mb-4 flex gap-4 border-b-2 border-gray-600 pb-4 text-4xl font-bold dark:border-gray-400"
    >
      <Translate page="workshop/git" key="title" /> <Icon name="fa-solid:code-branch" class="text-accent" />
    </h1>
    <p class="my-4">
      <b><Translate page="workshop/git" key="introLead" /></b>
      <Translate page="workshop/git" key="introRest">
        <b slot="leadName">Jakob</b>
      </Translate>
    </p>

    <div class="mb-8 mt-8">
      <A href="https://forms.cloud.microsoft/e/z2JEkxBUxr" target="_blank">
        <div
          class="flex justify-center gap-8 rounded-2xl bg-accent px-8 py-6 text-white shadow-md transition hover:shadow-xl"
        >
          <div class="flex items-center justify-center">
            <Icon name="fa-solid:file-signature" class="h-16 w-16" />
          </div>
          <div class="">
            <h2 class="mb-2 flex items-center gap-4 border-b-2 pb-2 text-3xl font-bold">
              <Translate page="workshop/git" key="signupTitle" /><span><Icon name="fa:external-link" class="w-6" /></span>
            </h2>

            <div class="text-lg font-bold">
              <div>🗓️ <Translate page="workshop/git" key="signupDate" /></div>
              <div>⏰ <Translate page="workshop/git" key="signupTime" /></div>
              <div>🗺️ <Translate page="workshop/git" key="signupLocation" /></div>
            </div>
          </div>
        </div>
      </A>
    </div>

    <h2 id="faq" class="mb-4 text-3xl font-bold"><Translate page="workshop/git" key="whatYouLearnTitle" /></h2>

    <p class="my-4"><Translate page="workshop/git" key="whatYouLearnIntro" /></p>

    <ul class="ml-6 list-[square] space-y-2 marker:text-accent">
      <li><b><Translate page="workshop/git" key="topics.1" /></b></li>
      <li><b><Translate page="workshop/git" key="topics.2" /></b></li>
      <li><b><Translate page="workshop/git" key="topics.3" /></b></li>
      <li><b><Translate page="workshop/git" key="topics.4" /></b></li>
      <li><b><Translate page="workshop/git" key="topics.5" /></b></li>
    </ul>

    <h2 id="faq" class="mb-4 mt-6 text-3xl font-bold"><Translate page="workshop/git" key="whatToBringTitle" /></h2>

    <p class="my-4">
      <Translate page="workshop/git" key="whatToBringIntro">
        <A slot="installGit" class="text-accent underline" href="https://git-scm.com/downloads">
          <Translate page="workshop/git" key="installGit" />
        </A>
      </Translate>
    </p>

    <p class="my-8 font-bold">
      <Translate page="workshop/git" key="contact">
        <A slot="discordLink" class="text-accent underline" href="https://discord.gg/3xBPkDsaXy">
          <Translate page="workshop/git" key="discord" />
        </A>
      </Translate>
    </p>
    <Image src={GitGudImage} alt="Git gud meme" class="mt-12 w-full rounded-xl" />
  </Container>
</BaseLayout>

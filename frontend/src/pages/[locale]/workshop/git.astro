---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/layout/Container.astro";
import GitGudImage from "@assets/gitgud.png";

import { Image } from "astro:assets";

import { Icon } from "astro-icon/components";
import { getStaticLanguagePaths } from "@i18n/utils.ts";
import { useTranslations } from "@i18n/utils.ts";
import A from "@components/ui/A.astro";

export const getStaticPaths = getStaticLanguagePaths();
const t = useTranslations(Astro.currentLocale);
---

<BaseLayout title={t("page.workshop.git.title")}>
  <Container>
    <h1
      class="mb-4 flex gap-4 border-b-2 border-gray-600 pb-4 text-4xl font-bold dark:border-gray-400"
    >
      {t("page.workshop.git.title")} <Icon name="fa-solid:code-branch" class="text-accent" />
    </h1>
    <p class="my-4">
      <b>{t("page.workshop.git.introLead")}</b>
      {t("page.workshop.git.introRest", { leadName: <b>Jakob</b> })}
    </p>

    <div class="mb-8 mt-8">
      <A href="https://forms.cloud.microsoft/e/z2JEkxBUxr" target="_blank">
        <div
          class="flex justify-center gap-8 rounded-2xl bg-accent px-8 py-6 text-white shadow-md transition hover:shadow-xl"
        >
          <div class="flex items-center justify-center">
            <Icon name="fa-solid:file-signature" class="h-16 w-16" />
          </div>
          <div class="">
            <h2 class="mb-2 flex items-center gap-4 border-b-2 pb-2 text-3xl font-bold">
              {t("page.workshop.git.signupTitle")}<span><Icon name="fa:external-link" class="w-6" /></span>
            </h2>

            <div class="text-lg font-bold">
              <div>🗓️ {t("page.workshop.git.signupDate")}</div>
              <div>⏰ {t("page.workshop.git.signupTime")}</div>
              <div>🗺️ {t("page.workshop.git.signupLocation")}</div>
            </div>
          </div>
        </div>
      </A>
    </div>

    <h2 id="faq" class="mb-4 text-3xl font-bold">{t("page.workshop.git.whatYouLearnTitle")}</h2>

    <p class="my-4">{t("page.workshop.git.whatYouLearnIntro")}</p>

    <ul class="ml-6 list-[square] space-y-2 marker:text-accent">
      <li><b>{t("page.workshop.git.topics.1")}</b></li>
      <li><b>{t("page.workshop.git.topics.2")}</b></li>
      <li><b>{t("page.workshop.git.topics.3")}</b></li>
      <li><b>{t("page.workshop.git.topics.4")}</b></li>
      <li><b>{t("page.workshop.git.topics.5")}</b></li>
    </ul>

    <h2 id="faq" class="mb-4 mt-6 text-3xl font-bold">{t("page.workshop.git.whatToBringTitle")}</h2>

    <p class="my-4">
      {t("page.workshop.git.whatToBringIntro", { installGit: <A class="text-accent underline" href="https://git-scm.com/downloads">{t("page.workshop.git.installGit")}</A>})}
    </p>

    <p class="my-8 font-bold">
      {t("page.workshop.git.contact", { discordLink: <A class="text-accent underline" href="https://discord.gg/3xBPkDsaXy">{t("page.workshop.git.discord")}</A> })}
    </p>
    <Image src={GitGudImage} alt="Git gud meme" class="mt-12 w-full rounded-xl" />
  </Container>
</BaseLayout>

---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/layout/Container.astro";
import Button from "@components/ui/Button.astro";
import { Icon } from "astro-icon/components";
import Socials from "@components/widgets/Socials.astro";
import Card from "@components/ui/Card.astro";
import { getStaticLanguagePaths } from "@i18n/utils.ts";
import { useTranslations } from "@i18n/utils.ts";

export const getStaticPaths = getStaticLanguagePaths();
const t = useTranslations(Astro.currentLocale);
const contacts = [
  {
    title: t("page.contact.contacts.general.title"),
    email: "post@betauia.net",
    description: t("page.contact.contacts.general.description"),
  },
  {
    title: t("page.contact.contacts.business.title"),
    email: "bedrift@betauia.net",
    description: t("page.contact.contacts.business.description"),
  },
  {
    title: t("page.contact.contacts.finance.title"),
    email: "økonomi@betauia.net",
    description: t("page.contact.contacts.finance.description"),
  },
];
---

<BaseLayout title={t("page.contact.title")}>
  <Container class="flex min-h-svh flex-col justify-center">
    <h1 class="mt-4 text-4xl font-semibold">{t("page.contact.title")}</h1>
    <p class="my-4 text-fg-muted dark:text-dark-fg-muted">{t("page.contact.intro")}</p>

    <div class="mt-4 grid gap-6 md:grid-cols-3">
      {
        contacts.map(({ title, email, description }) => (
          <Card title={title} text={description} href={`mailto:${email}`} highlightText={email} />
        ))
      }
    </div>

    <div class="mt-12">
      <h2 class="text-2xl font-medium">{t("page.contact.discordTitle")}</h2>
      <p class="mt-2 text-fg-muted dark:text-dark-fg-muted">{t("page.contact.discordText")}</p>
      <div class="mt-4">
        <Button href="https://discord.gg/3xBPkDsaXy" target="_blank">{t("page.contact.discordButton")}</Button>
      </div>
    </div>

    <Socials class="mb-6 mt-12" />
  </Container>
</BaseLayout>

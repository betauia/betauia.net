---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/layout/Container.astro";
import { getStaticLanguagePaths } from "@i18n/utils.ts";
import { useTranslations } from "@i18n/utils.ts";
import Translate from "@components/ui/Translate.astro";

export const getStaticPaths = getStaticLanguagePaths();
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const t = useTranslations(Astro.currentLocale);
---

<BaseLayout title={t("page.login.pageTitle")}>
  <Container>
    <div class="mx-auto max-w-md">
      <h1 class="mb-8 text-3xl font-bold"><Translate key="page.login.heading" /></h1>

      <div
        class="mb-4 rounded-lg border border-fg-muted bg-bg-raised p-6 dark:border-dark-fg-muted dark:bg-dark-bg-raised"
      >
        <h2 class="mb-4 text-xl font-bold"><Translate key="page.login.existingUser" /></h2>
        <form id="login-form">
          <div class="mb-4">
            <label for="login-email" class="mb-2 block text-sm font-medium">
              <Translate key="page.login.emailLabel" />
            </label>
            <input
              id="login-email"
              name="email"
              type="email"
              required
              class="w-full rounded-md border border-fg-muted/50 px-3 py-2 dark:border-dark-fg-muted/50 dark:bg-dark-fg-muted/20"
              placeholder="deg@eksempel.no"
            />
          </div>

          <div class="mb-6">
            <label for="login-password" class="mb-2 block text-sm font-medium">
              <Translate key="page.login.passwordLabel" />
            </label>
            <input
              id="login-password"
              name="password"
              type="password"
              required
              class="w-full rounded-md border border-fg-muted/50 px-3 py-2 dark:border-dark-fg-muted/50 dark:bg-dark-fg-muted/20"
              placeholder="••••••••••••"
            />
          </div>

          <button
            type="submit"
            id="login-btn"
            class="w-full rounded-md bg-accent px-4 py-2 text-dark-fg-base transition hover:bg-accent/80 disabled:opacity-50"
          >
            <Translate key="page.login.loginButton" />
          </button>
        </form>
      </div>

      <p class="mb-4 text-center text-fg-muted dark:text-dark-fg-muted">
        <Translate key="page.login.separator" />
      </p>

      <div
        class="rounded-lg border border-fg-muted bg-bg-raised p-6 shadow dark:border-dark-fg-muted dark:bg-dark-bg-raised"
      >
        <h2 class="mb-4 text-xl font-bold"><Translate key="page.login.newUser" /></h2>
        <form id="register-form">
          <div class="mb-6">
            <label for="register-email" class="mb-2 block text-sm font-medium">
              <Translate key="page.login.emailLabel" />
            </label>
            <input
              id="register-email"
              name="email"
              type="email"
              required
              class="w-full rounded-md border border-fg-muted/50 px-3 py-2 dark:border-dark-fg-muted/50 dark:bg-dark-fg-muted/20"
              placeholder="deg@eksempel.no"
            />
            <p class="mt-2 text-xs text-fg-muted dark:text-dark-fg-muted">
              <Translate key="page.login.confirmationNote" />
            </p>
          </div>

          <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
          <div
            class="cf-turnstile pb-6"
            data-sitekey={siteKey}
            data-callback="onTurnstileSuccess"
            data-expired-callback="onTurnstileExpired"
          >
          </div>
          <input type="hidden" name="cf-turnstile-response" />

          <button
            type="submit"
            id="register-btn"
            class="w-full rounded-md bg-accent px-4 py-2 text-dark-fg-base transition hover:bg-accent/80 disabled:cursor-not-allowed disabled:opacity-50"
          >
            <Translate key="page.login.registerButton" />
          </button>
        </form>
      </div>

      <!-- Messages -->
      <div id="error-message" class="mt-6 hidden rounded-md bg-red-200 p-4 dark:bg-red-900/20">
        <p class="text-sm text-red-800 dark:text-red-400"></p>
      </div>
      <div
        id="success-message"
        class="mt-6 hidden rounded-md bg-green-200 p-4 dark:bg-green-900/20"
      >
        <p class="text-sm text-green-900 dark:text-green-400"></p>
      </div>
    </div>
  </Container>
</BaseLayout>

<script>
  import { useTranslations } from "@i18n/utils";
  import { login, initiateRegistration } from "@lib/auth";
  import { popup } from "@lib/message";
  import { extractCurrentLanguage } from "@i18n/utils.ts";
  const t = useTranslations(extractCurrentLanguage());

  const loginForm = document.getElementById("login-form") as HTMLFormElement;
  const registerForm = document.getElementById("register-form") as HTMLFormElement;
  const errorMessage = document.getElementById("error-message");
  const successMessage = document.getElementById("success-message");

  declare global {
    interface Window {
      onTurnstileSuccess?: (token: string) => void;
    }
  }

  const registerBtn = document.getElementById("register-btn") as HTMLButtonElement;

  registerBtn.disabled = true;

  (window as any).onTurnstileSuccess = (token: string) => {
    const hiddenInput = registerForm.querySelector(
      'input[name="cf-turnstile-response"]'
    ) as HTMLInputElement;

    if (hiddenInput) hiddenInput.value = token;

    registerBtn.disabled = false;
  };

  (window as any).onTurnstileExpired = () => {
    registerBtn.disabled = true;
  };

  // Login
  loginForm?.addEventListener("submit", async e => {
    e.preventDefault();
    const formData = new FormData(loginForm);
    const loginBtn = document.getElementById("login-btn") as HTMLButtonElement;

    loginBtn.disabled = true;
    loginBtn.textContent = t("page.login.loginLoading");

    try {
      await login({
        email: formData.get("email") as string,
        password: formData.get("password") as string,
      });
      const params = new URLSearchParams(window.location.search);
      const redirectTo = params.get("redirect") || "/account";
      window.location.href = redirectTo;
    } catch (error) {
      popup(error instanceof Error ? error.message :  t("page.login.loginFailed"), "error", t("page.login.retry"));
      loginBtn.disabled = false;
      loginBtn.textContent = t("page.login.loginButton");
    }
  });

  // Register
  registerForm?.addEventListener("submit", async e => {
    e.preventDefault();
    const formData = new FormData(registerForm);
    const registerBtn = document.getElementById("register-btn") as HTMLButtonElement;

    const captchaToken = formData.get("cf-turnstile-response") as string;

    if (!captchaToken) {
      popup(t("page.login.registerError"), "error");
      return;
    }

    registerBtn.disabled = true;
    registerBtn.textContent = t("page.login.registerLoading");

    try {
      const response = await initiateRegistration({
        email: formData.get("email") as string,
        captcha_token: captchaToken,
      });

      if (response.verification_url) {
        window.location.href = response.verification_url;
        return;
      }

      popup(t("page.login.registerSuccess"), "success");
      registerForm.reset();
    } catch (error) {
      popup(error instanceof Error ? error.message : t("page.login.registerFailed"));
    } finally {
      registerBtn.textContent = t("page.login.registerButton");

      registerBtn.disabled = true;
      if ((window as any).turnstile) {
        (window as any).turnstile.reset();
      }
    }
  });
</script>

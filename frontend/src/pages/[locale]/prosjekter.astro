---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/layout/Container.astro";
import Card from "@components/ui/Card.astro";
import { useTranslations } from "@i18n/utils.ts";
import { getStaticLanguagePaths } from "@i18n/utils.ts";

export const getStaticPaths = getStaticLanguagePaths();

const t = useTranslations(Astro.currentLocale);

const projects = [
  {
    title: t("page.projects.cards.website.title"),
    description: t("page.projects.cards.website.description"),
    href: "https://github.com/betauia/betauia.net",
    highlightText: t("page.projects.cards.website.highlightText"),
  },
  {
    title: t("page.projects.cards.ctfer.title"),
    description: t("page.projects.cards.ctfer.description"),
    href: "https://discord.gg/3xBPkDsaXy",
    highlightText: t("page.projects.cards.ctfer.highlightText"),
  },
];
---

<BaseLayout title={t("page.projects.title")}>
  <Container class="flex min-h-svh flex-col justify-center">
    <h1 class="mb-4 text-4xl font-bold">{t("page.projects.title")}</h1>
    <p class="mb-6 text-fg-muted dark:text-dark-fg-muted">{t("page.projects.intro")}</p>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.map(project => (
          <Card
            title={project.title}
            text={project.description}
            href={project.href}
            highlightText={project.highlightText}
            frame="none"
          />
        ))
      }
    </div>

    <Card
      class="mt-12"
      title={t("page.projects.cta.title")}
      text={t("page.projects.cta.text")}
      href="/kontakt"
      highlightText={t("page.projects.cta.highlightText")}
    />
  </Container>
</BaseLayout>

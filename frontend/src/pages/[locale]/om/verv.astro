---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/layout/Container.astro";
import Prose from "@components/semantics/Prose.astro";
import { getStaticLanguagePaths } from "@i18n/utils.ts";
import { useTranslations } from "@i18n/utils.ts";
import Translate from "@components/ui/Translate.astro";

export const getStaticPaths = getStaticLanguagePaths();
const t = useTranslations(Astro.currentLocale);
---

<BaseLayout title={t("page.om.verv.title")}>
  <Container>
    <Prose>
      <h1><Translate key="page.om.verv.heading" /></h1>

      <h2><Translate key="page.om.verv.fearTitle" /></h2>
      <p><Translate key="page.om.verv.fearIntro1" /></p>
      <p><Translate key="page.om.verv.fearIntro2" /></p>

      <h2><Translate key="page.om.verv.rolesTitle" /></h2>
      <p><Translate key="page.om.verv.rolesIntro" /></p>

      <ul>
        <li>
          <strong><Translate key="page.board.profile.roles.leader" /></strong>:
          <Translate key="page.om.verv.roleDescriptions.leader" />
        </li>
        <li>
          <strong><Translate key="page.board.profile.roles.deputyLeader" /></strong>:
          <Translate key="page.om.verv.roleDescriptions.deputyLeader" />
        </li>
        <li>
          <strong><Translate key="page.board.profile.roles.financeManager" /></strong>:
          <Translate key="page.om.verv.roleDescriptions.financeManager" />
        </li>
        <li>
          <strong><Translate key="page.board.profile.roles.prManager" /></strong>:
          <Translate key="page.om.verv.roleDescriptions.prManager" />
        </li>
        <li>
          <strong><Translate key="page.board.profile.roles.betaLanLeader" /></strong>:
          <Translate key="page.om.verv.roleDescriptions.betaLanLeader" />
        </li>
        <li>
          <strong><Translate key="page.board.profile.roles.eventCommitteeLeader" /></strong>:
          <Translate key="page.om.verv.roleDescriptions.eventCommitteeLeader" />
        </li>
        <li>
          <strong><Translate key="page.board.profile.roles.businessCommitteeLeader" /></strong>:
          <Translate key="page.om.verv.roleDescriptions.businessCommitteeLeader" />
        </li>
        <li>
          <strong><Translate key="page.board.profile.roles.betaDevLeader" /></strong>:
          <Translate key="page.om.verv.roleDescriptions.betaDevLeader" />
        </li>
        <li>
          <strong><Translate key="page.board.profile.roles.betaSecLeader" /></strong>:
          <Translate key="page.om.verv.roleDescriptions.betaSecLeader" />
        </li>
      </ul>

      <p><Translate key="page.om.verv.footer" /></p>
    </Prose>
  </Container>
</BaseLayout>

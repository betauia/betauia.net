---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/layout/Container.astro";
import Prose from "@components/semantics/Prose.astro";
import { getStaticLanguagePaths } from "@i18n/utils.ts";
import { useTranslations } from "@i18n/utils.ts";

export const getStaticPaths = getStaticLanguagePaths();
const t = useTranslations(Astro.currentLocale);
---

<BaseLayout title={t("page.om.verv.title")}>
  <Container>
    <Prose>
      <h1>{t("page.om.verv.heading")}</h1>

      <h2>{t("page.om.verv.fearTitle")}</h2>
      <p>{t("page.om.verv.fearIntro1")}</p>
      <p>{t("page.om.verv.fearIntro2")}</p>

      <h2>{t("page.om.verv.rolesTitle")}</h2>
      <p>{t("page.om.verv.rolesIntro")}</p>

      <ul>
        <li>
          <strong>{t("page.board.profile.roles.leader")}</strong>:
          {t("page.om.verv.roleDescriptions.leader")}
        </li>
        <li>
          <strong>{t("page.board.profile.roles.deputyLeader")}</strong>:
          {t("page.om.verv.roleDescriptions.deputyLeader")}
        </li>
        <li>
          <strong>{t("page.board.profile.roles.financeManager")}</strong>:
          {t("page.om.verv.roleDescriptions.financeManager")}
        </li>
        <li>
          <strong>{t("page.board.profile.roles.prManager")}</strong>:
          {t("page.om.verv.roleDescriptions.prManager")}
        </li>
        <li>
          <strong>{t("page.board.profile.roles.betaLanLeader")}</strong>:
          {t("page.om.verv.roleDescriptions.betaLanLeader")}
        </li>
        <li>
          <strong>{t("page.board.profile.roles.eventCommitteeLeader")}</strong>:
          {t("page.om.verv.roleDescriptions.eventCommitteeLeader")}
        </li>
        <li>
          <strong>{t("page.board.profile.roles.businessCommitteeLeader")}</strong>:
          {t("page.om.verv.roleDescriptions.businessCommitteeLeader")}
        </li>
        <li>
          <strong>{t("page.board.profile.roles.betaDevLeader")}</strong>:
          {t("page.om.verv.roleDescriptions.betaDevLeader")}
        </li>
        <li>
          <strong>{t("page.board.profile.roles.betaSecLeader")}</strong>:
          {t("page.om.verv.roleDescriptions.betaSecLeader")}
        </li>
      </ul>

      <p>{t("page.om.verv.footer")}</p>
    </Prose>
  </Container>
</BaseLayout>
